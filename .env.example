# app.esporta.site — environment
#
# Copy to .env.local for development. On Vercel, set these as Project
# Environment Variables. Nothing here is a secret: the fallback pages read only
# the backend's public preview endpoint, which needs no key at all. If a value
# in this file ever needs to be secret, it is in the wrong place.

# Where this site is served from. Used to build canonical URLs and og:url, so it
# must be the real origin in production or link previews point at localhost.
NEXT_PUBLIC_SITE_URL=https://app.esporta.site

# The esporta-backend origin, including the /api/v1 prefix. The site calls
# GET {ESPORTA_API_BASE_URL}/public/preview/:kind/:id from the server only.
# Local: http://127.0.0.1:3000/api/v1
ESPORTA_API_BASE_URL=https://<REPLACE_WITH_ESPORTA_BACKEND_ORIGIN>/api/v1

# Store listings for the "Get Esporta" CTA.
# Android is derivable from the application id and needs no override.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.esporta.esporta
# iOS: leave empty until the App Store listing exists. Empty renders the iOS
# button as "coming soon" rather than linking somewhere wrong.
NEXT_PUBLIC_APP_STORE_URL=
