{
  "name": "esporta-app-site",
  "version": "0.1.0",
  "private": true,
  "description": "app.esporta.site — deep-link association files and the web fallback for canonical Esporta links",
  "scripts": {
    "dev": "next dev -p 3200",
    "dev:webpack": "next dev --webpack -p 3200",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "verify:wellknown": "bash verify.sh"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
